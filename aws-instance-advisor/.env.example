API_KEY=
BASE_URL=
MODEL_NAME=
VANTAGE_API_KEY=
TAVILY_API_KEY=
LLM_MAX_TOKENS=8192
# Caps the model's internal "thinking" budget specifically — separate from
# the overall response budget — to prevent reasoning-heavy models from
# consuming the entire max_tokens before producing visible output.
# This is a subset of LLM_MAX_TOKENS, not additional to it.
# The client maps this ratio onto OpenRouter reasoning.effort (low/medium/…)
# because OpenRouter rejects setting both effort and max_tokens, and several
# free-router models ignore reasoning.max_tokens.
LLM_REASONING_MAX_TOKENS=2048
# Optional second OpenRouter key for automatic rate-limit failover
API_KEY_2=

# Optional comma-separated list of OpenRouter model slugs to use as
# server-side fallbacks when the primary model (MODEL_NAME) is rate-limited
# or unavailable. OpenRouter tries each model in order before failing.
# This is additive to API_KEY_2 failover: keys handle per-account quotas,
# this handles per-model congestion. Leave empty to disable.
# Example free-tier models suited for structured JSON output:
# LLM_FALLBACK_MODELS=meta-llama/llama-3.1-70b-instruct:free,mistralai/mistral-7b-instruct:free,google/gemma-2-9b-it:free
LLM_FALLBACK_MODELS=

# Optional second model for OPT-IN multi-model consensus mode
# (API request {"message": "...", "consensus": true}).  The final
# holistic-recommend step is generated once more against this model using
# the identical technical_needs/candidates, then compared tier-by-tier
# deterministically — at the cost of one extra full LLM call.  Defaults to
# empty (consensus declines gracefully when requested without a model).
# When unset, the first LLM_FALLBACK_MODELS entry is used instead.
# Example: CONSENSUS_MODEL=mistralai/mistral-7b-instruct:free
CONSENSUS_MODEL=

# FastAPI HTTP layer (app/api/main.py). Set the real deployed frontend origin
# in production; there is intentionally no localhost fallback.
CORS_ALLOWED_ORIGIN=http://localhost:3000
PORT=8000
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Optional Redis-backed job store. When unset, jobs live in process-local
# memory — fine for single-instance dev/demo. Set this once you run
# multiple backend instances (jobs must be shared across them) or want
# jobs to survive restarts. Records expire after 24h so Redis never grows
# unbounded. Example: redis://localhost:6379/0 or a managed rediss:// URL.
REDIS_URL=

# Optional error monitoring via Sentry. When unset, the app runs identically
# and errors only appear in server logs — no Sentry SDK is initialized.
# Sentry's free tier comfortably covers this project's scale.
# Example: https://<key>@o0.ingest.sentry.io/0
SENTRY_DSN=
# Optional: fraction of requests traced for performance monitoring.
# Leave at 0 (default) for error monitoring only — tracing burns quota fast.
SENTRY_TRACES_SAMPLE_RATE=0.0
