[TEMPLATE]
# Backend base URL — set this in Vercel project settings at deploy time.
# For local dev, point at your running FastAPI server.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public origin of THIS frontend deployment. Used as metadataBase so the
# relative /opengraph-image URLs resolve into absolute ones that social
# crawlers can fetch (see src/app/layout.tsx). Falls back to
# http://localhost:3000 when unset, which is fine for local dev only.
NEXT_PUBLIC_SITE_URL=https://your-app.example.com
